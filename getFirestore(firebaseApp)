import { useEffect, useMemo, useState } from "react";
import { getFirestore } from "firebase/firestore";
import { createEduMindHybridRouter, type TelemetryEvent } from "../ai/hybridInference";
import {
  loadRecentTelemetryForDocument,
  saveStudySummaryToFirestore,
} from "../firebase/studyPersistence";
import { HybridTelemetryBadge, HybridTelemetryPanel } from "./HybridTelemetryPanel";

export function StudyWorkspaceWithFirestore({
  firebaseApp,
  docText,
  docName,
}: {
  firebaseApp: Parameters<typeof createEduMindHybridRouter>[0]["firebaseApp"];
  docText: string;
  docName: string;
}) {
  const db = useMemo(() => getFirestore(firebaseApp), [firebaseApp]);
  const [question, setQuestion] = useState("");
  const [answer, setAnswer] = useState("");
  const [telemetryLog, setTelemetryLog] = useState<TelemetryEvent[]>([]);
  const [saveStatus, setSaveStatus] = useState<string>("");
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    let active = true;
    if (!docName) return;
    loadRecentTelemetryForDocument(db, docName).then((savedEvents) => {
      if (active && savedEvents.length > 0) {
        setTelemetryLog(savedEvents);
      }
    });
    return () => {
      active = false;
    };
  }, [db, docName]);

  const router = useMemo(
    () =>
      createEduMindHybridRouter({
        firebaseApp,
        onTelemetry: (event) => {
          setTelemetryLog((prev) => [...prev, event]);
        },
      }),
    [firebaseApp]
  );

  async function handleRun(e: React.FormEvent) {
    e.preventDefault();
    if (!question.trim() || loading) return;
    setLoading(true);
    setSaveStatus("Saving to Firestore...");
    try {
      const res = await router.askOrSummarize({
        question: question.trim(),
        documentText: docText,
        documentName: docName,
      });
      setAnswer(res.text);

      const savedId = await saveStudySummaryToFirestore(db, {
        documentName: docName,
        documentChars: docText.length,
        question: question.trim(),
        summaryText: res.text,
        telemetry: res.telemetry,
      });
      setSaveStatus(`Saved to Firestore (studySummaries/${savedId})`);
    } catch (err) {
      setSaveStatus(
        err instanceof Error ? `Firestore save failed: ${err.message}` : "Firestore save failed"
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <h2 className="text-base font-semibold">EduMind AI Study Assistant</h2>
        <div className="flex items-center gap-2">
          {saveStatus && <span className="text-xs text-slate-500">{saveStatus}</span>}
          <HybridTelemetryBadge latest={telemetryLog[telemetryLog.length - 1]} />
        </div>
      </div>

      <form onSubmit={handleRun} className="flex gap-2">
        <input
          value={question}
          onChange={(e) => setQuestion(e.target.value)}
          placeholder='Ask a quick question or type "Summarize the whole pdf"...'
          className="flex-1 rounded-lg border px-3 py-2 text-sm"
        />
        <button
          type="submit"
          disabled={loading}
          className="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-50"
        >
          {loading ? "Running..." : "Send"}
        </button>
      </form>

      {answer && (
        <div className="whitespace-pre-wrap rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-800">
          {answer}
        </div>
      )}

      <HybridTelemetryPanel events={telemetryLog} onClear={() => setTelemetryLog([])} />
    </div>
  );
}
